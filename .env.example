# Public GA4 measurement ID only. Do not place service-account keys in frontend env vars.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase public project settings. These are safe for browser use when paired with RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NextAuth / Google OAuth. AUTH_SECRET must be a long random production secret.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# These belong on a secure backend for /admin analytics, never in browser code.
# Service account credentials for the Google Analytics Data API (grant it Viewer access to the property below).
GA_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Comma-separated allowlist of Google accounts permitted to sign in to /admin.
ADMIN_EMAIL=
